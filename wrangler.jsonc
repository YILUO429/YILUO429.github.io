{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yiluo-shopease",
  "compatibility_date": "2026-07-29",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "yiluo.rjly.de5.net",
      "custom_domain": true
    }
  ]
}
